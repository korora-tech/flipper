{
  "manifest_version": 2,
  "name": "Open with Flipper",
  "version": "0.2.0",
  "description": "Open the current link in a chosen Flipper browser profile, and open Flipper links in Firefox containers.",
  "permissions": ["contextMenus", "nativeMessaging", "cookies"],
  "background": { "scripts": ["background.js"] },
  "protocol_handlers": [
    { "protocol": "ext+flipper", "name": "Flipper", "uriTemplate": "/open.html#%s" }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "flipper@korora.tech", "strict_min_version": "115.0" }
  }
}
